-- ============================================================
--  ESP
-- ============================================================
local esp_cache: { [Player]: { box:any, name:any, hp:any } } = {}
local Camera = workspace.CurrentCamera

local function esp_add(p)
    if esp_cache[p] then return end
    local function sq(filled, col)
        local d = Drawing.new("Square")
        d.Thickness = 1.5; d.Filled = filled
        d.Color = col; d.Visible = false
        return d
    end
    local function tx()
        local d = Drawing.new("Text")
        d.Size = 12; d.Center = true; d.Outline = true
        d.Color = Color3.fromRGB(255,255,255); d.Visible = false
        return d
    end
    esp_cache[p] = { box = sq(false, Color3.fromRGB(255,60,60)), name = tx(), hp = sq(true, Color3.fromRGB(60,255,60)) }
end

local function esp_remove(p)
    if not esp_cache[p] then return end
    for _,d in pairs(esp_cache[p]) do d:Remove() end
    esp_cache[p] = nil
end

local function esp_hide(p)
    if not esp_cache[p] then return end
    esp_cache[p].box.Visible  = false
    esp_cache[p].name.Visible = false
    esp_cache[p].hp.Visible   = false
end

Players.PlayerRemoving:Connect(esp_remove)

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then esp_hide(p); continue end
        local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then esp_hide(p); continue end

        if not esp_on() then esp_hide(p); continue end

        esp_add(p)
        local ds = esp_cache[p]
        local sp, vis = Camera:WorldToViewportPoint(root.Position)

        if not vis then esp_hide(p); continue end

        local dist  = (root.Position - Camera.CFrame.Position).Magnitude
        local scale = 1600 / dist
        local bw, bh = scale * 1.1, scale * 1.8

        ds.box.Size     = Vector2.new(bw, bh)
        ds.box.Position = Vector2.new(sp.X - bw/2, sp.Y - bh/2)
        ds.box.Visible  = true

        ds.name.Text     = p.DisplayName .. "  " .. math.floor(dist) .. "m"
        ds.name.Position = Vector2.new(sp.X, sp.Y - bh/2 - 15)
        ds.name.Visible  = true

        local ratio   = math.clamp(hum.Health / math.max(hum.MaxHealth,1), 0, 1)
        ds.hp.Color   = Color3.fromRGB(math.floor((1-ratio)*255), math.floor(ratio*220), 50)
        ds.hp.Size    = Vector2.new(3, bh * ratio)
        ds.hp.Position= Vector2.new(sp.X - bw/2 - 7, sp.Y - bh/2 + bh*(1-ratio))
        ds.hp.Visible = true

        setstatus("👁  ESP actif — " .. #Players:GetPlayers()-1 .. " joueur(s)", Color3.fromRGB(100,200,255))
    end
end)

-- ============================================================
--  PUNCH HARDER
-- ============================================================
local mt    = getrawmetatable(game)
local old_nc = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if punch_on() and method == "FireServer" then
        local name = (self :: Instance).Name:lower()
        if name:find("attack") or name:find("punch") or name:find("hit") or name:find("damage") or name:find("swing") then
            local args = {...}
            for i,v in ipairs(args) do
                if type(v) == "number" and v > 0 and v < 99999 then
                    args[i] = v * 50
                end
            end
            return old_nc(self, table.unpack(args))
        end
    end
    return old_nc(self, ...)
end)
setreadonly(mt, true)

-- ============================================================
--  NO KNOCKBACK
-- ============================================================
RunService.Stepped:Connect(function()
    if not fly_on() then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end
    local vel = root.AssemblyLinearVelocity
    -- annule la vélocité horizontale imposée de l'extérieur
    if vel.Magnitude > 60 then
        root.AssemblyLinearVelocity = Vector3.new(vel.X * 0.05, vel.Y, vel.Z * 0.05)
    end
end)

