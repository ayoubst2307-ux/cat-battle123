        TextSize         = 13,
        Font             = Enum.Font.GothamBold,
    }, Win)
    mk("UICorner", { CornerRadius = UDim.new(0,6) }, btn)
    mk("UIStroke", { Color = Color3.fromRGB(60,40,140), Thickness = 1 }, btn)

    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text             = label .. (active and "  [ ON ]" or "  [ OFF ]")
        btn.BackgroundColor3 = active and active_col or Color3.fromRGB(30,20,60)
    end)
    return btn, function() return active end
end

